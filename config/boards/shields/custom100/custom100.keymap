#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Controller 1 (Central/Left): 6 rows x 11 cols = 66 keys
            // Controller 2 (Peripheral/Right): 6 rows x 10 cols = 60 keys
            // Total: 126 key positions
            // Passe die Tasten unten an dein Layout an!
            bindings = <
                /* Controller 1 - Row 1 */ &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
                /* Controller 1 - Row 2 */ &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P
                /* Controller 1 - Row 3 */ &kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI
                /* Controller 1 - Row 4 */ &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH
                /* Controller 1 - Row 5 */ &kp LCTRL &kp LGUI &kp LALT &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE &kp SPACE
                /* Controller 1 - Row 6 */ &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11

                /* Controller 2 - Row 1 */ &kp MINUS &kp EQUAL &kp BSPC &kp INS  &kp HOME &kp PG_UP &kp NUM_LOCK &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS
                /* Controller 2 - Row 2 */ &kp LBKT  &kp RBKT  &kp BSLH &kp DEL  &kp END  &kp PG_DN &kp KP_N7   &kp KP_N8    &kp KP_N9       &kp KP_PLUS
                /* Controller 2 - Row 3 */ &kp SQT   &kp RET   &kp RET  &kp RET  &kp RET  &kp RET   &kp KP_N4   &kp KP_N5    &kp KP_N6       &kp KP_PLUS
                /* Controller 2 - Row 4 */ &kp RSHFT &kp RSHFT &kp RSHFT &kp RSHFT &kp UP &kp RSHFT &kp KP_N1   &kp KP_N2    &kp KP_N3       &kp KP_ENTER
                /* Controller 2 - Row 5 */ &kp RCTRL &kp RALT  &kp RGUI  &kp LEFT &kp DOWN &kp RIGHT &kp KP_N0   &kp KP_N0    &kp KP_DOT      &kp KP_ENTER
                /* Controller 2 - Row 6 */ &kp F12   &kp PSCRN &kp SLCK  &kp PAUSE_BREAK &kp F12 &kp F12 &kp F12 &kp F12    &kp F12         &kp F12
            >;
        };
    };
};
