/*
 * Custom 100% Keyboard - Right/Peripheral Controller
 * Rows: P1.04, P0.11, P1.00, P0.24, P0.22, P0.20
 * Cols: P0.09, P0.10, P1.11, P1.13, P1.15, P0.02, P0.29, P0.31, P1.06, P0.17
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <6>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)
            RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(5,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";

        row-gpios
            = <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 1: P1.04 */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 2: P0.11 */
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 3: P1.00 */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 4: P0.24 */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 5: P0.22 */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 6: P0.20 */
            ;

        col-gpios
            = <&gpio0 9  GPIO_ACTIVE_HIGH>   /* Col 1:  P0.09 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>   /* Col 2:  P0.10 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>   /* Col 3:  P1.11 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* Col 4:  P1.13 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* Col 5:  P1.15 */
            , <&gpio0 2  GPIO_ACTIVE_HIGH>   /* Col 6:  P0.02 */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>   /* Col 7:  P0.29 */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>   /* Col 8:  P0.31 */
            , <&gpio1 6  GPIO_ACTIVE_HIGH>   /* Col 9:  P1.06 */
            , <&gpio0 17 GPIO_ACTIVE_HIGH>   /* Col 10: P0.17 */
            ;
    };
};
